# Target
CONFIG_IDF_TARGET="esp32s3"

# Flash: 16MB, QIO
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM: 8MB Octal (OPI) — ESP32-S3R8
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y

# CPU: 240MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# FreeRTOS tick for LVGL timing
CONFIG_FREERTOS_HZ=1000

# USB CDC for serial console over USB-C (USB-Serial-JTAG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Optimisation. LVGL's software renderer is the clock's hot path: a GIF tick
# fills ~29% of a 466x466 page in C, and flush_cb then byte-swaps and
# mirror-copies every one of those pixels. At the SDK default (-Og) that
# software render, not the QSPI transfer, set the frame budget; -O2 is the
# single cheapest fps win and costs only build time + a little flash.
CONFIG_COMPILER_OPTIMIZATION_LEVEL_RELEASE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# LVGL 9 configuration (managed component lvgl/lvgl)
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# Small fonts for the color-picker chips + hint line
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y

# ---------------------------------------------------------------------------
# Networking (config page). Bring-up + heap instrumentation build: the
# stage_probe() lines in main/net/orb_net.c are what decide the remaining RAM
# trims, so keep MEM_DEBUG on until those numbers are in hand.
# ---------------------------------------------------------------------------
CONFIG_ORB_NET_ENABLE=y
CONFIG_ORB_NET_MEM_DEBUG=y
CONFIG_ORB_NET_AP_FALLBACK=y
CONFIG_ORB_NET_HTTPD_PORT=80

# Header buffer MUST be raised from the 512 B default: a desktop browser's
# header block (User-Agent + Accept + Accept-Encoding + the sec-ch-ua family +
# Cookie) routinely reaches 1.5-3 KB, and esp_http_server rejects the whole
# request with 431 when it does not fit — i.e. the config page would not load at
# all from a laptop, only from a minimal client. This is per-SERVER (one
# HTTPD_SCRATCH_BUF allocation), not per-session, so 4 KB here costs 4 KB once.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=4096
CONFIG_HTTPD_MAX_URI_LEN=1024
# Chunked-transfer purge buffer: keep small, but non-trivial so a browser that
# sends an unneeded body on PATCH is drained without stalling the handler.
CONFIG_HTTPD_PURGE_BUF_LEN=256

# LWIP_MAX_SOCKETS is left at the 10 this project already builds with. It must
# be >= httpd's max_open_sockets + 3 (checked in esp_http_server's httpd_main.c)
# and orb_net uses max_open_sockets = 3, so 10 satisfies that assertion with four
# sockets to spare; it may be lowered toward 6 if the heap numbers justify it, but
# not below it or httpd_start() refuses to start.

# SNTP: TWO servers, not one. CONFIG_LWIP_SNTP_MAX_SERVERS sizes both lwIP's
# server table and esp_sntp_config_t.servers[], so the value must be at least
# the number of servers we configure — the IDF default of 1 makes the two-server
# config in orb_net.c impossible to pass. Rounded up to 3 so a future DHCP- or
# user-supplied third server does not need a re-pin of this line.
# The reason for two at all: a single hostname that fails to resolve (dead
# server, blocked DNS, a router whose resolver flaps) would otherwise cost the
# clock its time until the next association, and a wall clock that silently
# reverts to its boot epoch is the exact failure this feature exists to kill.
# Hourly re-sync is CONFIG_LWIP_SNTP_UPDATE_DELAY (IDF default 3600000) and is
# deliberately left at the default.
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# lwIP's default startup delay holds the FIRST request back by a random 0-4999 ms
# (SNTP_STARTUP_DELAY_FUNC = LWIP_RAND() % 5000) — a thundering-herd spreading
# meant for a fleet booting at once. This is one wall clock on a wall socket, so
# the spread buys nothing and costs up to five seconds of showing the wrong time
# after every association: measured time-to-synced after the DHCP lease ranged
# 0.4 s to 3.7 s with it on. Off means the exchange starts the moment on_ip()
# arms the client. The 15 s recv timeout and the retry ladder are untouched, so
# a dead server still fails over to the second one rather than hanging anything.
# CONFIG_LWIP_SNTP_STARTUP_DELAY is not set

# A/B rollback: ON, because this is a sealed device whose only other recovery
# path is opening the case and flashing over USB. The A/B slots in partitions.csv
# are not by themselves a safety net — without this, a successfully-uploaded image
# that turns out to hang the display becomes the permanent boot target and the
# orb is a brick until someone gets at the USB port. With it, the bootloader boots
# a new image in ESP_OTA_IMG_PENDING_VERIFY and reverts to the previous slot on the
# next reboot unless the app calls esp_ota_mark_app_valid_cancel_rollback() (main.c
# does, only after display_bench_snapshot() reports the dial actually drew frames).
# Consequences verified in esp_ota_ops.c: a second OTA while still PENDING_VERIFY
# returns ESP_ERR_OTA_ROLLBACK_INVALID_STATE (line 142) — deliberate, it stops an
# unproven image overwriting its own fallback — and idf.py flash resets boot
# selection because ota_data_initial.bin IS in build/flash_args, so USB recovery
# still works after a bad OTA. Costs a little otadata wear; worth it here.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y


# WiFi driver buffer counts: UNSET, so the IDF defaults apply (static-rx 10,
# dynamic-rx 32, dynamic-tx 32, mgmt-sbuf 32). They were pinned to 6/12/12/12 for
# one specific reason, that reason turned out to be a different line, and the trim
# is now gone on measurement. Do not re-add it without the evidence below.
#
# Why the trim existed: promoting the radio from WIFI_MODE_STA to WIFI_MODE_APSTA
# on a running station driver died with `alloc eb len=752 type=4 fail` -- the
# beacon's event buffer, the same 752 the driver logs at init -- followed by a
# LoadProhibited Guru in ieee80211_hostap. The EB pool is carved once at
# esp_wifi_init out of internal DMA RAM, and a disconnect does not return the
# static RX EBs, so static-rx=6 looked like the slack the late promotion needed.
#
# The mechanism was real; the cause was elsewhere. The pool was empty because
# CONFIG_LV_MEM_SIZE was 65536: LVGL's builtin heap is a static array in internal
# DRAM, and 64 KB of it left the driver no room. With LVGL at 24576 the defaults
# test clean -- measured on orb-B 2026-10-13, five first promotions after a fresh
# boot with the station connected, every one reaching SoftAP OPEN with the DHCP
# server banner up and zero `alloc eb` lines, at internal free 64,415-69,907 /
# largest block 28,672-31,744 / dma_free 56,911-62,403. At the original failure
# dma_free was 2,095.
#
# The earlier note here that "defaults fail" was measured at LVGL 65536 and does
# not transfer. If a promoted AP ever logs `alloc eb len=752 type=4 fail` again,
# check what is holding internal DRAM statically before touching these symbols.
#
# The wired path gave no signal either way: this build lost 5.6-11.6% of 250
# pings at BOTH settings, tracking RSSI (-61 to -71 dBm) rather than buffer
# counts, against a wired router control of 0.4%. The 0% reading once taken at the
# trim was RF luck and is not reproducible.
#
# The SoftAP no-IP / no-captive-prompt symptom this block used to describe was
# never a buffer problem: it was the same CONFIG_LV_MEM_SIZE shortage, which
# starved httpd (ESP_ERR_HTTPD_TASK) and the AP's DHCP path. See that symbol's
# own comment below and the ledger's 2026-10-13 correction.
#
# These live ONLY in the untracked generated sdkconfig as well; idf.py prefers
# that file over sdkconfig.defaults, so deleting the lines here is NOT enough to
# change a build -- the corresponding lines must go from sdkconfig too.

# WiFi IRAM optimizations stay ON (the IDF defaults). Do not "fix" this based on
# `idf.py size` reporting IRAM 16,383 / 16,384 (99.99%): that row is a fixed
# bucket and NOT this image's real instruction-RAM usage. This target's only
# instruction-RAM region is iram0_0_seg = 357,120 B, and the linker map shows
# .iram0.text at ~81 KB of it (~23%). Turning both options off was measured to
# free only 16,768 B of DIRAM while leaving that "16,383" byte-for-byte
# unchanged, i.e. the row does not track what those options move — so it is not
# evidence of an IRAM crunch, and there is no 16 KB IRAM ceiling to crash into.
# If IRAM ever genuinely overflows, ld says so loudly ("section .iram0.text will
# not fit in region iram0_0_seg"); that error, not this table, is the trigger to
# revisit CONFIG_ESP_WIFI_EXTRA_IRAM_OPT / these two knobs.

# LVGL's builtin heap: CONFIG_LV_USE_CLIB_MALLOC is off, so this is a STATIC
# ARRAY in internal DRAM, not a malloc. At the 64 KB default it starved the
# network stack enough to break phone provisioning outright -- httpd_start()
# returned ESP_ERR_HTTPD_TASK (its 4,096 B stack, esp_http_server.h:55, had
# nowhere contiguous to go once DHCP + captive DNS + mDNS-on-AP had taken their
# slices; measured largest free block on that boot: 7,936), main
# logged "networking down", the clock kept animating, and the config page simply
# did not exist while the captive DNS sent phones to a closed port.
# Measured on orb-B 2026-10-13 on a FORCED-PROVISIONING boot at IDF-default
# buffers (map-verified array size): 24576 -> largest block 31,744, page serves,
# lease handed out; 65536 -> largest block 7,936, httpd_start fails. Scope note:
# a CONNECTED boot promotes the SoftAP fine even at 65536 (verified tonight:
# OPEN + option 114 + DHCP started, zero alloc eb). Provisioning is the tight
# path because the AP is already up by the time httpd starts.
#
# PROVENANCE: nobody chose 64 KB. It is LVGL's own default
# (managed_components/lvgl__lvgl/Kconfig:112, `default 65536`), inherited silently
# because the symbol never appeared in any tracked file -- `git log --all
# -S CONFIG_LV_MEM_SIZE` returns only the commits that set it to 24576. So there
# is no earlier requirement being honored here, and no UI work (menu, carousel,
# theme import included) that ever needed more.
#
# MEASURED DEMAND, via lv_mem_monitor_core() sampled on the LVGL task and
# reported in /api/v1/status, with the app driven through every screen it has
# (clock, menu + full knob walk, color picker) and at both pool sizes:
#   peak used 19,796 B, live 15,804 B, 310 allocations -- IDENTICAL at 24 KB and
#   at 64 KB. Growing the pool changed the high-water mark by zero bytes; it only
#   moved unused memory out of the network stack's reach.
#   At 24 KB the pool presents 22,052 usable bytes (TLSF header), so peak is 90%
#   of it with 5,936 B in the largest free block. That headroom is thin, and it is
#   the ONLY cost of this line: nothing regressed measurably on the dial.
#   At 64 KB internal free fell to 7,411 / largest 3,328, which is the exact
#   signature of the provisioning failure -- re-measured by accident on this bench.
# HEADROOM IS THE RISK, NOT RENDERING. If a screen pushes peak past ~21 KB, LVGL
# returns NULL and the widget silently fails to appear (LV_LOG_WARN only; no
# assert trips, the clock keeps running), so it must be caught before shipping.
# Re-measure the same way. `CONFIG_LV_USE_CLIB_MALLOC=y` was tested as an escape
# from the fixed array and is NOT the fix it looks like: the 20 KB stayed in
# internal RAM anyway, because CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384 sends
# every allocation under 16 KB there regardless of PSRAM, and lv_mem_monitor()
# stops reporting (clib has no TLSF walker). It gives flexible sizing, not PSRAM.
# Reaching PSRAM for real needs ALWAYSINTERNAL lowered, then a re-measure of dial
# frame rate, since object reads would cross the SPI bus.
CONFIG_LV_MEM_SIZE=24576

# ---------------------------------------------------------------------------
# microSD (theme import). See main/sd/orb_sd.h for what the socket is and is
# not for, and docs/usb-sd-msc-plan.md §2 for the wiring this is built on.
# ---------------------------------------------------------------------------
CONFIG_ORB_SD_ENABLE=y
CONFIG_ORB_SD_SPI_MAX_KHZ=20000
CONFIG_ORB_SD_RETRY_S=30

# Long filenames MUST be on. With the IDF/sdkconfig default of LFN_NONE, FATFS
# is 8.3-only and silently mangles exactly the names this feature is used with:
# "orbital-arrow-3.orbtheme" becomes ORBITA~1.THE and "clock_overlay.png"
# becomes CLOCK_~1.PNG, so the page lists names nobody typed and a theme kit
# copied onto the card by hand cannot be matched back to what it is. HEAP (not
# STACK) because the buffer would otherwise land on the httpd task's stack,
# which HTTPD_DEFAULT_CONFIG() sizes at 4096 bytes.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
CONFIG_FATFS_CODEPAGE_437=y

# The /api/v1/screen bench door (plan §7 item 7). Tracked here because a new
# Kconfig `default y` does NOT materialize into an existing local sdkconfig —
# idf.py treats that file as authoritative, and a #if CONFIG_ORB_DEBUG_HTTP
# handler silently compiles out with a binary that barely grows.
CONFIG_ORB_DEBUG_HTTP=y

# ---------------------------------------------------------------------------
# Radio pools off the internal-DMA budget, so the SD driver gets its asks back
# (docs/app-platform-plan.md §16.1).
#
# SERIAL EVIDENCE, same boot, orb-A 2026-10-14 (image `e3733a5`): a theme upload
# died 1.5 s in with `esp_dma_capable_malloc(125): Not enough heap memory` and
# `sdmmc_write_blocks failed (0x101)`. The card is healthy — SD16G SDHC 29.4 GB
# mounts at 20 MHz on POST /api/v1/sd/rescan — so the failure is the budget at
# that instant, not the slot. sdmmc's per-operation ask is 125 B and it must be
# internal DMA RAM. The radio holds that pool: dynamic TX (32 buffers,
# allocated per-frame as the heap allows), AMPDU RX windows (RX_BA_WIN=6
# reorder contexts), and `esp-aes: Failed to allocate memory` already logged
# during the WPA3-SAE handshake on the same boot. §15's tail billed the identical
# squeeze a day earlier, and §16.1 named this the real wall in front of M5.
#
# The four lines below move the radio off that pool rather than shrink it:
#   - TRY_ALLOCATE_WIFI_LWIP: radio + lwIP buffers go to PSRAM first.
#   - TX_BUFFER_TYPE=0 (the static choice): a fixed TX ring instead of 32
#     dynamic buffers competing for the same DMA heap at TX time.
#   - STATIC_TX_BUFFER_NUM=8: the ring sized to what this link actually
#     in-flights (IDF default 16 halves the saving).
#   - AMPDU_RX off: drops the RX reorder windows, the other standing claim on
#     internal DMA RAM. Costs aggregation on the RX side; the dial and the
#     upload path both live inside the link's own throughput.
#
# CONFIG_ESP_WIFI_TX_BUFFER_TYPE is a derived int with no prompt: the CHOICE
# symbols are what kconfig reads, so the local sdkconfig must carry
# CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y and DYNAMIC_TX_BUFFER off for the int to
# land at 0 — and DYNAMIC_TX_BUFFER cannot survive TRY_ALLOCATE_WIFI_LWIP=y
# anyway (Kconfig:82 makes it undeterminable when PSRAM is not ignorable).
# Prove all four in build/config/sdkconfig.h after reconfigure, per the
# materialization rule: an EXIT=0 build that silently kept the dynamic pools is
# the false pass this file has been burned by twice already.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=0
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

